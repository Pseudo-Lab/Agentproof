{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentProof trial",
  "type": "object",
  "required": [
    "run_id",
    "task_id",
    "condition",
    "repeat_id",
    "status",
    "score",
    "latency_ms",
    "input_tokens",
    "output_tokens",
    "cost_usd",
    "missing_reasons",
    "evidence"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "condition": {
      "enum": [
        "baseline",
        "intervention"
      ]
    },
    "repeat_id": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "success",
        "failure",
        "error",
        "timeout"
      ]
    },
    "score": {
      "type": [
        "number",
        "null"
      ]
    },
    "missing_reasons": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "object",
      "minProperties": 1
    },
    "latency_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "output_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "score": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "missing_reasons": {
            "required": [
              "score"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "latency_ms": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "missing_reasons": {
            "required": [
              "latency_ms"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "input_tokens": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "missing_reasons": {
            "required": [
              "input_tokens"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "output_tokens": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "missing_reasons": {
            "required": [
              "output_tokens"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cost_usd": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "missing_reasons": {
            "required": [
              "cost_usd"
            ]
          }
        }
      }
    }
  ]
}
