#!/usr/bin/env bash
# Execute pinned CodeStruct plus the recorded UTF-8 fix in its private environment.
set -eu
aci_bundle_dir="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
for aci_arg in "$@"; do
  if [ "$aci_arg" = --replacement-stdin ]; then
    exec "$aci_bundle_dir/.venv/bin/python" "$aci_bundle_dir/stdin_edit.py" "$@"
  fi
done
exec "$aci_bundle_dir/.venv/bin/python" "$aci_bundle_dir/upstream/ast_edit/bin/editCode" "$@"
